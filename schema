# ---------- Mutations ----------
type Mutation {
	createUser(input: CreateUserInput!): User
	updateUser(input: UpdateUserInput!): User
	deleteUser(user_id: ID!): ID
	createCustomer(input: CreateCustomerInput!): Customer
	updateCustomer(input: UpdateCustomerInput!): Customer
	createTrainer(input: CreateTrainerInput!): Trainer
	updateTrainer(input: UpdateTrainerInput!): Trainer
	createWorkout(input: CreateWorkoutInput!): Workout
	createWorkoutItem(input: CreateWorkoutItemInput!): WorkoutItem
	createSession(input: CreateSessionInput!): Session
	createSessionItem(input: CreateSessionItemInput!): SessionItem
	createSessionItemSet(input: CreateSessionItemSetInput!): SessionItemSet
	createSessionItemRep(input: CreateSessionItemRepInput!): SessionItemRep
	createWorkoutProduct(input: CreateWorkoutProductInput!): WorkoutProduct
	createVirtualTrainingService(input: CreateVirtualTrainingServiceInput!): VirtualTrainingService
	updateVirtualTrainingService(input: UpdateVirtualTrainingServiceInput!): VirtualTrainingService
	deleteVirtualTrainingService(service_id: ID!): ID
	# Stripe Onboarding
	setupStripeOnboarding(trainer_id: ID!, email: String!): StripeResponse
	# Stripe Checkout
	createStripeCheckout(
		trainer_id: ID!,
		trainer_user_id: ID!,
		user_id: ID!,
		price: Float!,
		product_name: String!,
		product_id: ID!,
		product_type: String!
	): StripeResponse
	# Stripe Product Sync
	createStripeProduct(
		trainer_id: ID!,
		name: String!,
		price: Float!,
		description: String,
		product_type: String,
		workout_ids: [ID],
		workout_products: [ID],
		difficulty_level: String,
		fitness_goal: String,
		duration_weeks: Int
	): StripeProductResponse
}

type StripeProductResponse {
	workout_product_id: String
	service_id: String
	stripe_product_id: String
	stripe_price_id: String
	error: String
}

# ---------- Queries ----------
type Query {
	getUser(user_id: ID!): User
	listUsers(limit: Int, nextToken: String): [User!]!
	getCustomer(customer_id: ID!): Customer
	listCustomers(filter: CustomerFilterInput, limit: Int, nextToken: String): CustomerConnection
	getTrainer(trainer_id: ID!): Trainer
	listTrainers(filter: TrainerFilterInput, limit: Int, nextToken: String): TrainerConnection
	getWorkout(workout_id: ID!): Workout
	listWorkoutsByCustomer(customer_id: ID!, limit: Int, nextToken: String): [Workout!]!
	listWorkoutItems(workout_id: ID!, limit: Int, nextToken: String): [WorkoutItem!]!
	getSession(session_id: ID!): Session
	listSessionsByCustomer(customer_id: ID!, limit: Int, nextToken: String): [Session!]!
	listSessionItemsBySession(session_id: ID!, limit: Int, nextToken: String): [SessionItem!]!
	getSessionItemSet(session_id: ID!, session_item_index: Int!): SessionItemSet
	listSessionItemSets(
		session_id: ID!,
		session_item_index: Int!,
		limit: Int,
		nextToken: String
	): [SessionItemSet!]!
	listSessionItemReps(session_id: ID!, limit: Int, nextToken: String): SessionItemRepConnection
	getExercise(exercise_id: ID!): Exercise
		@aws_cognito_user_pools
@aws_api_key
	listExercises(limit: Int, nextToken: String): ExerciseConnection
		@aws_cognito_user_pools
@aws_api_key
	listWorkoutsByTrainer(trainer_id: ID!, limit: Int, nextToken: String): [Workout!]!
	listWorkoutProductsByTrainer(trainer_id: ID!, limit: Int, nextToken: String): [WorkoutProduct!]!
	getWorkoutProduct(trainer_id: ID!, workout_product_id: ID!): WorkoutProduct
	getVirtualTrainingService(trainer_id: ID!, service_id: ID!): VirtualTrainingService
	listVirtualTrainingServicesByTrainer(trainer_id: ID!, limit: Int, nextToken: String): VirtualTrainingServiceConnection
	# Permissions
	getPermission(user_id: ID!, resource_id: ID!): Permission
	listPermissionsByUser(user_id: ID!, limit: Int, nextToken: String): PermissionConnection
}