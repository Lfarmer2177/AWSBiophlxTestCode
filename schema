# ---------- Types ----------
type Customer {
	customer_id: ID!
	user_id: ID!
	preferred_workout_location: String
	fitness_focus: String
	created_at: AWSDateTime
	updated_at: AWSDateTime
}

type CustomerConnection {
	items: [Customer!]!
	nextToken: String
}

input CustomerFilterInput {
	user_id: IDComparisonInput
}

type Exercise @aws_cognito_user_pools
@aws_api_key {
	exercise_id: ID!
	name: String
	category: String
	muscle_group: [String]
	equipment_required: [String]
	instructions: [String]
	exercise_image: AWSURL
	exercise_profile_id: ID
	created_at: AWSDateTime
	updated_at: AWSDateTime
}

type ExerciseConnection @aws_cognito_user_pools
@aws_api_key {
	items: [Exercise]
	nextToken: String
}

type ExerciseProfile {
	exercise_profile_id: ID!
	version: String
	exercise_config_blob: AWSJSON
	created_at: AWSDateTime
	updated_at: AWSDateTime
}

input IDComparisonInput {
	eq: ID
}

type Session {
	session_id: ID!
	customer_id: ID!
	workout_id: ID
	workout_date: AWSDateTime!
	created_at: AWSDateTime
	updated_at: AWSDateTime
}

type SessionItem {
	session_id: ID!
	session_item_index: Int!
	workout_id: ID
	workout_index: Int
	exercise_id: ID!
	muscle_focus: String
	created_at: AWSDateTime
	updated_at: AWSDateTime
}

type SessionItemRep {
	session_id: ID!
	session_item_index: Int!
	session_item_set_index: Int!
	session_item_rep_index: Int!
	tut: Float
	velocity: Int
	momentum: Int
	score: Int
	rom: Int
	created_at: AWSDateTime
	updated_at: AWSDateTime
	rep_key: String
	session_item_key: String
}

type SessionItemRepConnection {
	items: [SessionItemRep!]!
	nextToken: String
}

type SessionItemSet {
	session_id: ID!
	session_item_index: Int!
	session_item_set_index: Int!
	weight_lifted: Float
	created_at: AWSDateTime
	updated_at: AWSDateTime
}

type StripeResponse {
	url: String
	onboarding_url: String
	stripe_account_id: String
	error: String
}

